source "https://rubygems.org"

# The github-pages gem pins the exact Jekyll + plugin versions GitHub Pages uses,
# so what builds here builds there.
gem "github-pages", group: :jekyll_plugins

# Needed on Ruby 3+ for `jekyll serve`, and for time zones on Windows.
gem "webrick", "~> 1.8"
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1", platforms: [:mingw, :mswin, :x64_mingw]
